# SMTP Configuration for Email Deliverability
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000

# SMTP Configuration (Example for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail: Use an App Password, not your regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Configuration
# The email address that appears as the sender
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Where to send notification emails (your business email)
NOTIFICATION_EMAIL=your-business-email@gmail.com

# Alternative SMTP Providers
# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# For Outlook/Office365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password

# For Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@yourdomain.mailgun.org
# SMTP_PASS=your-mailgun-password